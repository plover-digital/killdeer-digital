http://billing.killdeer.digital, https://billing.killdeer.digital {
  redir https://billing.stripe.com/p/login/8wM4kaa9S7vb7u0bII 302
}

killdeer.digital, http://killdeer.digital {
  encode zstd gzip

  # Browser terminal. The page and its WASM SSH core come from killdeer-site;
  # only the WebSocket relay at /ssh/_ws/ goes to the sshterm-server
  # container. It is a login page, so it is only ever served over HTTPS.
  @insecure_ssh {
    protocol http
    path /ssh /ssh/*
  }
  redir @insecure_ssh https://{host}{uri} 308
  redir /ssh /ssh/ 308
  handle /ssh/_ws/* {
    uri strip_prefix /ssh
    reverse_proxy sshterm:8080
  }

  handle {
    reverse_proxy killdeer-site:8080
  }
}
